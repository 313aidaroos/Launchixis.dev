# Launchixis: environment variables. Copy to .env.local for local dev;
# set the same names in Vercel → Settings → Environment Variables. Never commit real values.

# ── Added 2026-09-25: keys the code reads that were not listed here ──
# Required
# Comma-separated emails allowed to edit (admins).
ADMIN_EMAILS=
# Cixy's AI (console.anthropic.com → API keys). Server only.
ANTHROPIC_API_KEY=
# Supabase anon/publishable key.
SUPABASE_ANON_KEY=
# Supabase service_role key. Server only, never NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Supabase project URL (server).
SUPABASE_URL=
# This site's Apixis Wallet key (apx_live_…). From `npm run family-keys` in ApixisWallet. Server only.
WALLET_API_KEY=
# Optional
# Wallet base URL. Default https://apixis-wallet.vercel.app
APIXIS_WALLET_API_URL=
# Public site URL, e.g. https://<site>.vercel.app
APP_URL=
# Public site URL, e.g. https://<site>.vercel.app
NEXT_PUBLIC_APP_URL=
# Optional Cixy model override. Default claude-sonnet-5 (claude-3-5-sonnet was retired 2025-10-28).
ANTHROPIC_MODEL=
# Developer scripts only (not Vercel)
# Developer scripts only (Supabase CLI). Not needed on Vercel.
# SUPABASE_ACCESS_TOKEN=
# Developer deploy script only. Not needed on Vercel.
# VERCEL_TOKEN=
# Legacy names (leave unset)
# Legacy name for WALLET_API_KEY. Leave unset.
# APIXIS_WALLET_API_KEY=

# --- Read by the code but missing above (added 2026-10-02) ---
APIXIS_CLIENT_ID=launchixis
# optional; defaults to <this site>/auth/apixis/callback
APIXIS_REDIRECT_URI=
# this site's public URL
NEXT_PUBLIC_SITE_URL=
# Supabase anon key
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# optional; new-style key instead of the anon key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Supabase project URL
NEXT_PUBLIC_SUPABASE_URL=
# optional; new-style key instead of the service role key
SUPABASE_SECRET_KEY=

# Shared family feed (server only)
APIXIS_WORLD_KEY=
APIXIS_WORLD_API=https://www.apixis.dev
# Optional Cixy model override (takes precedence over ANTHROPIC_MODEL)
AI_MODEL=

# Card checkout (Apixis Dev LLC). Leave unset until Awad sets prices.
# Prefer a restricted key in STRIPE_RESTRICTED_KEY. STRIPE_SECRET_KEY is the fallback.
# Each Stripe Price needs metadata product=launchixis and sku set to the matching product key.
# Webhook endpoint: /api/stripe/webhook
# STRIPE_RESTRICTED_KEY=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_LAUNCHIXIS_CHECKLIST=
# STRIPE_PRICE_LAUNCHIXIS_BRAND_KIT=
# STRIPE_PRICE_LAUNCHIXIS_OPS_SEAT=
# STRIPE_PRICE_LAUNCHIXIS_ENTERPRISE=
